# Copia este archivo a .env.local y rellena los valores (no lo subas con valores reales).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Supabase → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# Panel de admin
ADMIN_PASSWORD=
# Cadena aleatoria de 32+ caracteres: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Opcional pero recomendado en producción: límite compartido entre instancias
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Máximo de partidas nuevas generadas con IA por día (por defecto 300)
PREGUNTAS_DAILY_LIMIT=

# AdSense: IDs de bloques (AdSense → Anuncios → Por bloque de anuncios). Son públicos.
NEXT_PUBLIC_ADSENSE_SLOT_HORIZONTAL=
NEXT_PUBLIC_ADSENSE_SLOT_RECTANGLE=
NEXT_PUBLIC_ADSENSE_SLOT_VERTICAL=
